# 全可选：不配也能跑（内容 API 优雅降级）。配齐即完整体验。
DATABASE_URL=postgres://user:pass@host:5432/blog     # 内容管线 + 持久化（CNPG）
REDIS_URL=redis://:pass@host:6379/0                   # Agent 限流（可选）
LITELLM_BASE_URL=https://gateway.example/v1           # 任意 OpenAI 兼容网关
LITELLM_KEY=***
LITELLM_CHAT_MODEL=model-id
ADMIN_TOKEN=***                                      # /api/admin/* Bearer 守卫
TYPESAFE_API_KEY=***
